---
// The numbered list of principles on the home page.
const principles = [
	['A persona is a whole role, not a prompt.', 'The domain model, the records, the playbooks, the guardrails and the tests travel together.'],
	['Definitions are declarative, never code.', 'JSON and Markdown that anyone can read in a pull request and any runtime can load without executing it.'],
	['Nothing in a definition belongs to one installation.', 'No model account, credential, person or database identifier. The workspace supplies those at run time.'],
	['Approval comes before an effect.', 'A persona declares what needs a person’s decision. A runtime that cannot enforce that holds the step.'],
	['A persona is tested before it is released.', 'Requirements point to what implements them and to the cases that verify them.'],
	['A runtime says what it cannot run.', 'Unsupported steps are blocked and reported, never silently replaced.'],
];
---

<ol class="ps-principles not-content">
	{
		principles.map(([title, detail], index) => (
			<li data-reveal style={`--i:${index}`}>
				<span class="n">{index + 1}</span>
				<span>
					{title}
					<small>{detail}</small>
				</span>
			</li>
		))
	}
</ol>

<script>
	import '../scripts/reveal.ts';
</script>
