---
import { Icon } from '@astrojs/starlight/components';

const groups = [
  {
    title: 'Define a persona',
    icon: 'open-book',
    links: [
      { text: 'App inventory and ontology', href: './concepts/personas-and-workspaces/#map-the-organizations-apps' },
      { text: 'Personas and workspaces', href: './concepts/personas-and-workspaces/' },
      { text: 'Implementation guide', href: './implementation/' },
      { text: 'Folder structure', href: './specification/#1-folder-structure-' },
      { text: 'Registry and pinned revisions', href: './specification/#5-registry-' },
      { text: 'Definitions and root skill', href: './specification/#2-skillmd-' },
    ],
  },
  {
    title: 'Run a team',
    icon: 'rocket',
    links: [
      { text: 'Teams, goals, and playbooks', href: './concepts/teams-and-goals/' },
      { text: 'Connectors and approvals', href: './concepts/connectors-and-approvals/' },
      { text: 'Runtime rules', href: './specification/#7-runtime-rules' },
      { text: 'Runs and collaboration', href: './concepts/runs-and-collaboration/' },
    ],
  },
  {
    title: 'Publish and extend',
    icon: 'window',
    links: [
      { text: 'Records, pipelines, and apps', href: './concepts/records-and-apps/' },
      { text: 'Live sync', href: './apps/#7-live-sync-' },
      { text: 'Gabriel Operator skills', href: './skills/' },
      { text: 'Learn from specialist review', href: './concepts/signals-and-evals/#learn-from-specialist-review' },
      { text: 'Signals, evidence, and evals', href: './concepts/signals-and-evals/' },
      { text: 'Worked examples', href: './examples/' },
    ],
  },
] as const;
---

<nav class="ap-reference-menu not-content" aria-label="Specification topics">
  {groups.map((group) => (
    <section class="ap-reference-group">
      <h3><Icon name={group.icon} /> {group.title}</h3>
      <ul>
        {group.links.map(({ text, href }) => (
          <li><a href={href}>{text}<Icon name="right-arrow" /></a></li>
        ))}
      </ul>
    </section>
  ))}
</nav>
