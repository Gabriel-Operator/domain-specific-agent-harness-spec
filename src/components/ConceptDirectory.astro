---
import { getCollection } from 'astro:content';
import {
  Activity, ArrowRight, BadgeCheck, BookOpen, Bot, Brain, Cable, CalendarClock,
  CirclePlay, ClipboardCheck, ClipboardList, CodeXml, Database, FileCheck,
  FileCode, Files, FlaskConical, FolderOpen, GitBranch, GitFork, IdCard, KeyRound,
  LayoutGrid, ListTree, LockKeyhole, MessageSquareText, Network, Package,
  Plug, Radio, ScanLine, ScrollText, Server, ShieldCheck, Store, Target, Unplug, Users,
  UserRoundCheck, Workflow, Wrench,
} from '@lucide/astro';

const categories = [
  ['definitions', 'Core definitions'],
  ['execution', 'Execution and governance'],
  ['data', 'Data and integrations'],
  ['infrastructure', 'Infrastructure and distribution'],
] as const;

const icons = {
  'agent-harness': Workflow,
  agents: Bot,
  approvals: BadgeCheck,
  apps: LayoutGrid,
  'code-execution': CodeXml,
  connectors: Cable,
  'context-and-conversations': MessageSquareText,
  'data-feeds': Radio,
  delegation: GitFork,
  evals: ClipboardCheck,
  'execution-receipts': FileCheck,
  'files-and-artifacts': Files,
  goals: Target,
  'governed-execution': ShieldCheck,
  hooks: Unplug,
  'human-review': UserRoundCheck,
  'live-sync-and-presence': Activity,
  marketplace: Store,
  'model-providers': Plug,
  models: Brain,
  ontology: Network,
  packaging: Package,
  persona: IdCard,
  pipelines: GitBranch,
  playbooks: ListTree,
  prompts: ScrollText,
  'records-and-lists': Database,
  registry: ClipboardList,
  'resource-binding': KeyRound,
  'resource-keys': FileCode,
  runs: CirclePlay,
  runtime: Server,
  'sandbox-rehearsal': FlaskConical,
  'scheduled-work': CalendarClock,
  signals: ScanLine,
  skills: BookOpen,
  teams: Users,
  tools: Wrench,
  vault: LockKeyhole,
  workspaces: FolderOpen,
};

const concepts = (await getCollection('docs')).flatMap(({ id, data }) => {
  if (!data.concept || data.draft) return [];
  const slug = id.replace(/^concepts\//, '');
  const icon = icons[slug as keyof typeof icons];
  if (!icon) throw new Error(`Missing anatomy icon for ${id}`);
  return [{ id, data, concept: data.concept, Icon: icon }];
}).sort((first, second) => first.concept.order - second.concept.order);
const base = Astro.locals.starlightRoute.siteTitleHref;
---

<div class="concept-directory not-content">
  {categories.map(([category, title]) => (
    <section class="concept-group" aria-labelledby={`concept-${category}`}>
      <h3 id={`concept-${category}`}>{title}</h3>
      <div class="concept-grid">
        {concepts.filter(({ concept }) => concept.category === category).map(({ id, data, Icon }) => (
          <a class="concept-card" href={`${base}${id}/`}>
            <span class="concept-card-heading">
              <Icon size={19} stroke-width={1.65} class="concept-icon" aria-hidden="true" />
              <span>{data.title}</span>
              <ArrowRight size={15} stroke-width={1.65} class="concept-arrow" aria-hidden="true" />
            </span>
            {data.description && <span class="concept-description">{data.description}</span>}
          </a>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .concept-directory {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.75rem);
    margin-block: 1.5rem 2.25rem;
  }

  .concept-group h3 {
    margin: 0 0 0.875rem;
  }

  .concept-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.875rem;
  }

  @media (min-width: 58rem) {
    .concept-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .concept-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--ap-line);
    border-radius: 0.5rem;
    background: var(--ap-surface);
    color: var(--ap-ink);
    text-decoration: none;
  }

  .concept-card:hover,
  .concept-card:focus-visible {
    border-color: var(--ap-muted);
    background: var(--sl-color-bg);
  }

  .concept-card:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .concept-card-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.625rem;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .concept-icon,
  .concept-arrow {
    margin-block-start: 0.12em;
    color: var(--ap-muted);
  }

  .concept-arrow {
    margin-block-start: 0.24em;
  }

  .concept-description {
    color: var(--ap-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>
