---
import { Icon } from '@astrojs/starlight/components';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="ap-hero">
  <h1 id="_top" data-page-title>{siteTitle}</h1>
  <p>An open specification for composing reusable playbooks into domain teams. Goals drive the work, connectors bring the data, and experts guide improvement.</p>
  <nav class="ap-topics" aria-label="Start here">
    <a href={siteTitleHref + '#why-a-domain-specific-harness'}>Read the story <Icon name="down-arrow" /></a>
    <a href={siteTitleHref + '#where-the-spec-starts'}>Where the spec starts</a>
    <a href={siteTitleHref + '#architecture-at-a-glance'}>Architecture</a>
    <a href={siteTitleHref + '#explore-the-specification'}>Explore the spec</a>
  </nav>
</div>
