---
import { Icon } from '@astrojs/starlight/components';

const { siteTitle } = Astro.locals.starlightRoute;
---

<div class="ap-hero">
  <h1 id="_top" data-page-title>{siteTitle}</h1>
  <p>Map the apps your organization uses. Give agents a shared domain model, and let your experts guide how the harness improves.</p>
  <button type="button" class="ap-search" data-hero-search hidden aria-haspopup="dialog">
    <Icon name="magnifier" />
    <span>Search documentation…</span>
    <kbd aria-hidden="true"></kbd>
  </button>
  <nav class="ap-topics" aria-label="Start here">
    <a href="#why-a-domain-specific-harness">Read the story <Icon name="down-arrow" /></a>
    <a href="#worked-example">Worked example</a>
    <a href="#learn-from-approvals">Learn from approvals</a>
    <a href="#explore-the-specification">Explore the spec</a>
  </nav>
</div>

<script>
  // Share the header's Starlight search dialog and Pagefind index.
  await customElements.whenDefined('site-search');
  const trigger = document.querySelector<HTMLButtonElement>('[data-hero-search]');
  const open = document.querySelector<HTMLButtonElement>('site-search [data-open-modal]');
  const dialog = document.querySelector<HTMLDialogElement>('site-search dialog');

  if (trigger && open && dialog) {
    trigger.hidden = false;
    const key = trigger.querySelector('kbd');
    if (key) key.textContent = open.querySelector('kbd')?.textContent?.trim() || 'Ctrl K';
    trigger.addEventListener('click', (event) => {
      // Starlight listens for outside clicks after it opens the dialog.
      event.stopPropagation();
      open.click();
    });
  }
</script>
