---
import { Icon } from '@astrojs/starlight/components';

const src = `${Astro.locals.starlightRoute.siteTitleHref}architecture.svg`;
const alt = 'A workspace loads a persona. Team goals invoke playbooks through the harness. The harness prepares, rehearses, and seeks human approval before protected live actions. Connectors use vault credentials, receipts inform revisions, and playbooks can be reused across personas.';
---

<figure class="architecture-diagram not-content">
  <a href={src} aria-label="Enlarge architecture diagram" data-diagram-open>
    <img src={src} width="1200" height="1050" loading="lazy" alt={alt} />
    <span class="architecture-action"><Icon name="magnifier" /> Enlarge diagram</span>
  </a>

  <dialog class="architecture-dialog" aria-labelledby="architecture-dialog-title">
    <div class="architecture-dialog-header">
      <h3 id="architecture-dialog-title">Harness architecture</h3>
      <button type="button" data-diagram-close autofocus>
        <Icon name="close" /> Close
      </button>
    </div>
    <div class="architecture-diagram-scroll" tabindex="0" role="region" aria-label="Scrollable architecture diagram">
      <img src={src} width="1200" height="1050" loading="lazy" alt={alt} />
    </div>
  </dialog>
</figure>

<script>
  const diagram = document.querySelector('.architecture-diagram');
  const trigger = diagram?.querySelector<HTMLAnchorElement>('[data-diagram-open]');
  const dialog = diagram?.querySelector('dialog');
  const close = dialog?.querySelector<HTMLButtonElement>('[data-diagram-close]');

  if (trigger && dialog && close && typeof dialog.showModal === 'function') {
    trigger.setAttribute('aria-haspopup', 'dialog');
    trigger.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      dialog.showModal();
    });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => trigger.focus({ preventScroll: true }));
  }
</script>

<style>
  .architecture-diagram {
    margin: 1.25rem 0;
  }

  .architecture-diagram > a {
    display: grid;
    justify-items: end;
    gap: 0.5rem;
    color: var(--ap-ink);
    text-decoration: none;
  }

  .architecture-diagram > a:hover .architecture-action {
    text-decoration: underline;
  }

  .architecture-diagram img {
    display: block;
    width: 100%;
    height: auto;
  }

  .architecture-action,
  .architecture-dialog button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
  }

  .architecture-dialog {
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    width: min(calc(100% - 2rem), 90rem);
    max-width: none;
    height: calc(100% - 2rem);
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--ap-line);
    border-radius: 0.65rem;
    background: var(--sl-color-bg);
    color: var(--ap-ink);
    overflow: hidden;
  }

  .architecture-dialog[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  :global(html:has(.architecture-dialog[open])) { overflow: hidden; }

  .architecture-dialog::backdrop {
    background: var(--sl-color-backdrop-overlay);
  }

  .architecture-dialog-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--ap-line);
  }

  .architecture-dialog-header h3 {
    margin: 0;
    font-size: 1.0625rem;
  }

  .architecture-dialog button {
    min-height: 2.25rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--ap-line);
    border-radius: 0.375rem;
    background: var(--ap-surface);
    color: var(--ap-ink);
    cursor: pointer;
  }

  .architecture-diagram-scroll {
    overflow: auto;
    overscroll-behavior: contain;
  }

  .architecture-diagram-scroll img {
    min-width: 48rem;
    max-width: 75rem;
    margin-inline: auto;
  }

  @media print {
    .architecture-action { display: none; }
  }
</style>
