---
import { Code } from '@astrojs/starlight/components';

// An instruction a reader can paste into a coding agent. The address follows wherever the site is published.
const published = 'https://gabriel-operator.github.io/domain-specific-agent-harness-spec/';
const home = import.meta.env.SITE ? new URL(import.meta.env.BASE_URL, import.meta.env.SITE).href : published;
const index = new URL('llms.txt', home.endsWith('/') ? home : `${home}/`).href;
const instruction = `Read ${index} and the pages it lists before you author a persona or implement a runtime.`;
---

<Code code={instruction} lang="text" wrap />
