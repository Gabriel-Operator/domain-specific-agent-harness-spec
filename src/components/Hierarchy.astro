---
// What a persona folder holds: a shared library of playbooks and one or more teams. Each team owns its bots, apps,
// lists and pipelines. The figures are from one persona's team file.
const playbooks = ['meeting-watcher', 'brief-researcher', 'briefing-caller', 'meeting-scribe', 'pilot-research'];
const playbookCount = 17;

const teams = [
	{
		name: 'Meeting follow-through',
		rows: [
			['Bots', '6, each runs one playbook'],
			['Apps', '3'],
			['Lists and pipelines', '1 list, 1 pipeline'],
		],
	},
	{
		name: 'Prospect to pilot',
		rows: [
			['Bots', '7, each runs one playbook'],
			['Apps', '1'],
			['Lists and pipelines', '1 list, 1 pipeline'],
		],
	},
];
---

<div class="ps-tree not-content" data-reveal="children">
	<div class="ps-tree-folder">
		<p class="ps-tree-label">persona-lane/ <span>the persona folder</span></p>
		<div class="ps-tree-body">
			<div class="ps-tree-box" style="--i:0">
				<p class="ps-tree-title">Playbook library <span>{playbookCount} playbooks</span></p>
				<ul class="ps-tree-chips">
					{playbooks.map((playbook) => <li>{playbook}</li>)}
					<li class="more">and {playbookCount - playbooks.length} more</li>
				</ul>
				<p class="ps-tree-note">Shared by every team in the folder.</p>
			</div>
			<div class="ps-tree-teams">
				{
					teams.map((team, index) => (
						<div class="ps-tree-box" data-kind="team" style={`--i:${index + 1}`}>
							<p class="ps-tree-title">
								{team.name} <span>team</span>
							</p>
							<dl>
								{team.rows.map(([name, value]) => (
									<div>
										<dt>{name}</dt>
										<dd>{value}</dd>
									</div>
								))}
								<div class="proposed">
									<dt>Packaged apps</dt>
									<dd>proposed</dd>
								</div>
							</dl>
						</div>
					))
				}
			</div>
		</div>
	</div>
</div>

<script>
	import '../scripts/reveal.ts';
</script>
