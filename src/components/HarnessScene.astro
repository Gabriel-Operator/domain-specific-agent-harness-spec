---
import { Icon } from '@astrojs/starlight/components';

interface Props {
  scene: 'draft' | 'fragments' | 'persona' | 'plan' | 'runtime' | 'app';
}

const { scene } = Astro.props;
---

<div class="hs-visual">
  {scene === 'draft' && (
    <div class="hs-window">
      <div class="hs-window-title"><Icon name="comment-alt" /> Agent session</div>
      <div class="hs-window-row">
        <span class="hs-meta">Request</span>
        <strong>Research Northwind and draft a follow-up.</strong>
      </div>
      <div class="hs-window-row">
        <span class="hs-meta">Agent</span>
        <strong>One draft ready</strong>
        <span>Search results and notes from this session</span>
      </div>
    </div>
  )}

  {scene === 'fragments' && (
    <>
      <div class="hs-stack">
        <div class="hs-tile"><Icon name="comment" /><span><strong>Research chat</strong><small>Northwind looks qualified</small></span></div>
        <div class="hs-tile"><Icon name="database" /><span><strong>Prospects list</strong><small>Northwind · Identified</small></span></div>
        <div class="hs-tile"><Icon name="email" /><span><strong>Inbox draft</strong><small>Edited after review</small></span></div>
      </div>
      <p class="hs-note hs-warning"><Icon name="warning" /> Which draft was approved?</p>
    </>
  )}

  {scene === 'persona' && (
    <div class="hs-window">
      <div class="hs-window-title"><Icon name="code-branch" /> Lane persona</div>
      <div class="hs-window-row"><strong><code>SKILL.md</code></strong><span>Instructions and domain rules</span></div>
      <div class="hs-window-row"><strong><code>assets/ontology.json</code></strong><span>Prospects, meetings, and pilots</span></div>
      <div class="hs-window-row"><strong><code>assets/studio-teams.json</code></strong><span>Prospect to pilot team</span></div>
    </div>
  )}

  {scene === 'plan' && (
    <>
      <div class="hs-tile hs-emphasis"><Icon name="approve-check-circle" /><span><strong>Goal</strong><small>Qualify Northwind and prepare a follow-up</small></span></div>
      <div class="hs-down"><Icon name="down-arrow" /><span>Draft or reuse playbooks</span></div>
      <div class="hs-pair">
        <div class="hs-tile"><Icon name="magnifier" /><span><strong>Research fit</strong><small>Exa search</small></span></div>
        <div class="hs-tile"><Icon name="email" /><span><strong>Follow up</strong><small>Gmail send</small></span></div>
      </div>
    </>
  )}

  {scene === 'runtime' && (
    <>
      <div class="hs-stack">
        <div class="hs-tile"><Icon name="code-branch" /><span><strong>Verify definitions</strong><small>Revision and fingerprint</small></span></div>
        <div class="hs-tile"><Icon name="link" /><span><strong>Bind the workspace</strong><small>Harness and connector accounts</small></span></div>
        <div class="hs-tile hs-emphasis"><Icon name="padlock" /><span><strong>Wait at the send step</strong><small>Review recipient and message</small></span></div>
      </div>
      <p class="hs-note"><Icon name="approve-check-circle" /> Publish only declared fields</p>
    </>
  )}

  {scene === 'app' && (
    <>
      <div class="hs-pair">
        <div class="hs-tile"><Icon name="puzzle" /><span><strong>Connector data</strong><small>Company evidence</small></span></div>
        <div class="hs-tile"><Icon name="rocket" /><span><strong>Agent updates</strong><small>Approved outreach sent</small></span></div>
      </div>
      <div class="hs-down"><Icon name="down-arrow" /><span>Publish to prospects list</span></div>
      <div class="hs-window">
        <div class="hs-window-title"><Icon name="window" /> Pilot prospects</div>
        <div class="hs-window-row hs-record">
          <strong>Northwind</strong><span>Contacted</span>
        </div>
      </div>
    </>
  )}
</div>
