---
import { Icon } from '@astrojs/starlight/components';

interface Props {
  id: string;
  file: string;
  alt: string;
  width: number;
  height: number;
  title: string;
  action: string;
  fitImage?: boolean;
}

const { id, file, alt, width, height, title, action, fitImage = false } = Astro.props;
const src = Astro.locals.starlightRoute.siteTitleHref + file;
const titleId = id + '-preview-title';
---

<figure class="image-preview not-content">
  <a href={src} aria-label={action} data-preview-open>
    <img src={src} width={width} height={height} loading="lazy" alt={alt} />
    <span class="image-preview-action"><Icon name="magnifier" /> {action}</span>
  </a>

  <dialog class:list={['image-preview-dialog', { 'fit-image': fitImage }]} aria-labelledby={titleId}>
    <div class="image-preview-dialog-header">
      <h3 id={titleId}>{title}</h3>
      <button type="button" data-preview-close autofocus>
        <Icon name="close" /> Close
      </button>
    </div>
    <div class="image-preview-scroll" tabindex="0" role="region" aria-label={title}>
      <img src={src} width={width} height={height} loading="lazy" alt={alt} />
    </div>
  </dialog>
</figure>

<script>
  for (const preview of document.querySelectorAll('.image-preview')) {
    const trigger = preview.querySelector<HTMLAnchorElement>('[data-preview-open]');
    const dialog = preview.querySelector('dialog');
    const close = dialog?.querySelector<HTMLButtonElement>('[data-preview-close]');
    if (!trigger || !dialog || !close || typeof dialog.showModal !== 'function') continue;

    trigger.setAttribute('aria-haspopup', 'dialog');
    trigger.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      dialog.showModal();
    });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => trigger.focus({ preventScroll: true }));
  }
</script>

<style>
  .image-preview {
    margin: 1.25rem 0;
  }

  .image-preview > a {
    display: grid;
    justify-items: end;
    gap: 0.5rem;
    color: var(--ap-ink);
    text-decoration: none;
  }

  .image-preview > a:hover .image-preview-action {
    text-decoration: underline;
  }

  .image-preview img {
    display: block;
    width: 100%;
    height: auto;
  }

  .image-preview-action,
  .image-preview-dialog button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
  }

  .image-preview-dialog {
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    width: min(calc(100% - 2rem), 90rem);
    max-width: none;
    height: calc(100% - 2rem);
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--ap-line);
    border-radius: 0.65rem;
    background: var(--sl-color-bg);
    color: var(--ap-ink);
    overflow: hidden;
  }

  .image-preview-dialog[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  :global(html:has(.image-preview-dialog[open])) { overflow: hidden; }

  .image-preview-dialog::backdrop {
    background: var(--sl-color-backdrop-overlay);
  }

  .image-preview-dialog-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--ap-line);
  }

  .image-preview-dialog-header h3 {
    margin: 0;
    font-size: 1.0625rem;
  }

  .image-preview-dialog button {
    min-height: 2.25rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--ap-line);
    border-radius: 0.375rem;
    background: var(--ap-surface);
    color: var(--ap-ink);
    cursor: pointer;
  }

  .image-preview-scroll {
    overflow: auto;
    overscroll-behavior: contain;
  }

  .image-preview-scroll img {
    min-width: 48rem;
    max-width: 75rem;
    margin-inline: auto;
  }

  .fit-image {
    width: min(calc(100% - 2rem), 96rem, max(22rem, calc((100dvh - 6rem) * 1.5)));
    height: auto;
    max-height: calc(100dvh - 2rem);
  }

  .fit-image .image-preview-scroll img {
    min-width: 0;
    max-width: none;
  }

  @media (max-width: 45rem) {
    .fit-image .image-preview-scroll img { min-width: 42rem; }
  }

  @media print {
    .image-preview-action { display: none; }
  }
</style>
