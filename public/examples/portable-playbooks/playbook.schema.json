                "name",
                "revision",
                "kind",
                "objective",
                "completionCriteria"
              ],
              "additionalProperties": false
            }
          ]
        },
        "skill": {
          "type": "string",
          "maxLength": 71,
          "pattern": "^skills\\/[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "schemaVersion",
        "definition"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
